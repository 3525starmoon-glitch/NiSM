  "optimizer": "Adam",
  "learning_rate": 0.0001,
  "batch_size": 64,
  "max_epochs": 100,
  "loss": "MAE",
  "scheduler": "ReduceLROnPlateau",
  "scheduler_factor": 0.2,
  "scheduler_patience": 3,
  "early_stopping_patience": 15,
  "normalization": "MinMax fitted on the training users",
  "paper_parameter_label": "66.39M"
