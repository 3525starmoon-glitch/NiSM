{
  "model": "PiMForce (Dense)",
  "reference_environment": {
    "cpu": "Intel Xeon Gold 6138 @ 2.00 GHz",
    "gpu": "NVIDIA A800 (80 GB)",
    "python": "3.9",
    "pytorch": "2.5.1"
  },
  "modalities": [
    "8-channel EMG",
    "3D hand posture"
  ],
  "pose_backbone": "3D ResNet",
  "pose_block_layout": [
    3,
